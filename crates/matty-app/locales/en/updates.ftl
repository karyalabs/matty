## The in-app updater's notifications (updater.rs)

update-ready = Update ready
update-ready-detail = Matty { $version } has downloaded. Restart to finish updating.
update-restart = Restart to update
update-later = Later
update-install-failed = Couldn't install the update
update-dismiss = Dismiss

# Check for updates, from the app menu or Preferences > Advanced.
update-checking = Checking for updates…
update-downloading = Downloading Matty { $version }…
update-downloading-detail = It installs when you restart Matty.
update-up-to-date = You're up to date
update-up-to-date-detail = Matty { $version } is the latest version.
update-check-failed = Couldn't check for updates
update-unsupported = This build doesn't update itself
update-unsupported-detail = Download new versions from Matty's releases page.
update-open-releases = Open releases
update-web = Matty on the web is always up to date
update-web-detail = Reload the page to get the latest version.
