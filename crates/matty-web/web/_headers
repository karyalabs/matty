# GPUI's web platform shares WebAssembly memory with worker threads, which
# browsers only allow on cross-origin isolated pages. Requests to Mattermost
# servers are CORS fetches, which isolation allows.
/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer

# The page is checked on every load; it names the app's files, which
# scripts/web names by their content, so the browser keeps those for good
# and a warm launch fetches nothing but the page (and Chrome reuses the
# compiled app). The demo keeps its name, so it is checked each time.
/*.html
  Cache-Control: no-cache
/matty/
  Cache-Control: no-cache
/*.wasm
  Cache-Control: public, max-age=31536000, immutable
/*.js
  Cache-Control: public, max-age=31536000, immutable
/*.gz
  Cache-Control: no-cache
