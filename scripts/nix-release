#!/usr/bin/env python3
"""Points the Nix package at a release (docs/nix.md).

    scripts/nix-release VERSION SHA256SUMS

Writes nix/release.json with VERSION and the Nix hash of that release's
Linux tarball, read from the release's SHA256SUMS. The Release workflow
runs it after publishing; nothing is downloaded here.
"""

import base64
import json
import pathlib
import sys


def main() -> None:
    version, sums = sys.argv[1:3]
    tarball = f"Matty-{version}-linux-x86_64.tar.gz"
    for line in pathlib.Path(sums).read_text().splitlines():
        digest, _, name = line.partition("  ")
        if name.lstrip("*") == tarball:
            break
    else:
        sys.exit(f"{tarball} is not in {sums}")
    sri = "sha256-" + base64.b64encode(bytes.fromhex(digest)).decode()
    out = pathlib.Path(__file__).resolve().parent.parent / "nix" / "release.json"
    out.write_text(json.dumps({"version": version, "hash": sri}, indent=2) + "\n")
    print(f"{out.name}: {version} {sri}")


if __name__ == "__main__":
    main()
